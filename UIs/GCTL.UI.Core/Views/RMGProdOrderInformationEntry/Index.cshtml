    <script>
        $(document).ready(function() {
            // Initial state: Show password row, hide samaul row
            $('.password-row').show();
            $('.samaul-row').hide();

            // Toggle on radio change
            $('input[name="option"]').on('change', function() {
                if ($('#optionA').is(':checked')) {
                    $('.password-row').show();
                    $('.samaul-row').hide();
                } else if ($('#optionB').is(':checked')) {
                    $('.password-row').hide();
                    $('.samaul-row').show();
                }
            });
        });
    </script>
