    .form-container {
        display: grid;
        grid-template-columns: 75% 25%;
        gap: 0;
        max-width: 100%;
        margin: 0 auto;
    }

    .left-panel {
        border: 1px solid #dee2e6;
        border-top: 0;
        padding: 15px;
        margin : 16px;
        padding-top: 0px;
        margin-top: 0px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0px;
    }
    .form-grid-color {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 0px;
    }
    .form-grid-color-dt {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr 0.5fr;
        gap: 0px;
    }

    .form-row {
        display: grid;
        grid-template-columns: 33% 1fr;
        align-items: center;
        gap: 0px;
        margin-bottom: 0px;
    }

        .form-row label {
            text-align: right;
            white-space: nowrap;
            padding-right: 0;
        }

        .form-row .input-group {
            padding-left: 5px;
        }

    .full-width {
        grid-column: 1 / -1;
        margin-bottom: 5px;
    }

        .full-width .form-row {
            grid-template-columns: 16.5% 1fr;
        }

    .radio-group {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 5px;
    }

    .radio-item {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 1;
        cursor:pointer;
    }

    .radio-item, input, label {
       
        cursor: pointer;
    }



    .right-panel {
        border: 1px solid #dee2e6;
        padding: 15px;
    }


   

    .bank-fieldset {
        border: 2px solid #ccc;
        border-radius: 8px;
        padding: 15px;
        margin: 20px 0;
        background: #fff;
    }

        .bank-fieldset legend {
            font-weight: bold;
            font-size: 1.1rem;
            padding: 0 10px;
            width: auto !important;
            float: none;
        }

    .percentage-input-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr 1fr 1fr;
        gap: 5px;
        padding-left: 5px;
        align-items: center;
    }

    .grid-input {
        height: 31px;
        padding: 0 8px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        font-size: 0.875rem;
    }

    .input-percent-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

        .input-percent-wrapper input {
            width: 100%;
            padding-right: 25px;
        }

    .percent-symbol {
        position: absolute;
        right: 8px;
        pointer-events: none;
        color: #6c757d;
        font-size: 0.875rem;
    }



    #btnPreviewPdf, #downloadReport {
        transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
        min-width: 120px;
        min-height: 25px;
        position: relative;
        overflow: visible;
    }

        #btnPreviewPdf:hover,
        #downloadReport:hover {
            background-color: rgba(173, 255, 47, 0.2) !important;
            color: #1e90ff !important;
            border-color: #1e90ff !important;
            box-shadow: 0 4px 10px rgba(30, 144, 255, 0.5) !important;
        }


        #btnPreviewPdf i,
        #btnPreviewPdf span,
        #downloadReport i,
        #downloadReport span {
            transition: transform 0.3s ease;
            display: inline-block;
            transform: scale(1);
            margin-right: 2px;
        }

        #btnPreviewPdf:hover i,
        #downloadReport:hover i {
            transform: scale(1.3);
        }





    .toolbar-container {
        background-color: #fff;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        padding: 0;
    }

    .toolbar-section {
        padding: 8px 15px;
        border-bottom: 1px solid #e0e0e0;
    }

        .toolbar-section:last-child {
            border-bottom: none;
        }

    .toolbar-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        justify-content:center;
    }

    .toolbar-group {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 4px 0;
    }

    .toolbar-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 16px;
        font-size: 13px;
        border: 1px solid #ccc;
        border-radius: 3px;
        background-color: #fff;
        color: #333;
        cursor: pointer;
        transition: all 0.2s;
        white-space: nowrap;
        height: 32px;
    }

        .toolbar-btn:hover {
            background-color: #f8f9fa;
            border-color: #999;
        }

        .toolbar-btn i {
            font-size: 14px;
        }

        .toolbar-btn.icon-only {
            padding: 6px 12px;
            min-width: 36px;
            justify-content: center;
        }

    .toolbar-select {
        height: 32px;
        font-size: 13px;
        border: 1px solid #ccc;
        border-radius: 3px;
        padding: 4px 32px 4px 10px;
        background-color: #fff;
        cursor: pointer;
        min-width: 150px;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23343a40' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m2 5 6 6 6-6'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 10px center;
        background-size: 12px;
        appearance: none;
    }

        .toolbar-select:focus {
            outline: none;
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }

    .toolbar-divider {
        width: 1px;
        height: 24px;
        background-color: #dee2e6;
        margin: 0 4px;
    }

    .icon-group {
        display: flex;
        gap: 4px;
        padding: 4px;
        background-color: #f8f9fa;
        border-radius: 4px;
        border: 1px solid #e0e0e0;
    }

        .icon-group .toolbar-btn {
            border: 1px solid transparent;
            background-color: transparent;
        }

            .icon-group .toolbar-btn:hover {
                background-color: #fff;
                border-color: #ccc;
            }

    /* Mail Send button special styling */
    .mail-send-btn {
        background-color: #f0f0f0;
        font-weight: 500;
    }

        .mail-send-btn i {
            color: #666;
        }

    @@media (max-width: 768px) {
        .toolbar-actions

    {
        flex-direction: column;
        align-items: stretch;
    }

    .toolbar-group {
        flex-wrap: wrap;
    }

    .toolbar-select {
        min-width: 100%;
    }

    }

    .btn-group-sm .btn {
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
        line-height: 1.5;
    }

        .btn-group-sm .btn i {
            font-size: 0.875rem;
        }
</style>

