<style>
    .custom-fieldset {
        position: relative;
        border: 2px solid #ddd;
        border-radius: 10px;
        padding: 30px 20px 20px 20px;
        margin: 20px 0;
        box-shadow: 0 0 10px rgba(76, 175, 80, 0.2);
    }

        .custom-fieldset legend {
            position: absolute;
            top: -14px;
            left: 20px;
            background-color: white;
            padding: 0 10px;
            font-size: 1.2em;
            font-weight: bold;
            color: #727272;
            border: 1px solid #ddd;
            border-radius: 5px;
            width: auto;
        }

        .custom-fieldset label {
            display: block;
            margin-top: 10px;
            font-weight: 500;
            color: #333;
        }

        .custom-fieldset input[type="text"],
        .custom-fieldset input[type="email"],
        .custom-fieldset input[type="date"] {
            width: 100%;
            padding: 8px;
            margin-top: 5px;
            border: 1px solid #ddd;
            border-radius: 5px;
            box-sizing: border-box;
            color: #000;
        }

        .custom-fieldset input[type="submit"] {
            margin-top: 15px;
            padding: 10px 20px;
            background-color: #fff;
            border: 2px solid #333;
            border-radius: 5px;
            color: white;
            font-weight: bold;
            cursor: pointer;
        }

            .custom-fieldset input[type="submit"]:hover {
                background-color: #45a049;
                border-color: #45a049;
            }

    #stickyHeader {
        position: sticky;
        top: 0;
        z-index: 1050;
        background: white;
        padding: 10px 20px;
        transition: all 0.3s ease-in-out;
        box-shadow: none;
    }

        #stickyHeader.scrolled {
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
        }


    /* input[type="text"], */
    input[type="email"],
    input[type="date"],
    input[type="number"],
    input[type="password"],
    select,
    textarea {
        border: 1px solid #ccc !important;
        border-radius: 4px;
        padding: 6px 10px;
        box-sizing: border-box;
        outline: none;
    }

        input:focus,
        select:focus,
        textarea:focus {
            border-color: #999 !important;
            box-shadow: none;
        }



    .flatpickr-calendar.inline {
        font-size: 12px !important;
        max-width: 9.9vw !important;
        border: none !important;
        padding: 0 !important;
        margin: 0 !important;
        box-shadow: none !important;
        background: transparent !important;
    }


    .dataTables_wrapper .dataTables_filter input {
        border: 1px solid #ced4da;
        border-radius: 4px;
        padding: 0px;
    }
    /* Remove padding, margin, border, background, and hover effects */
    .dataTables_wrapper .dataTables_paginate .paginate_button {
        padding: 0 !important;
        margin: 0 !important;
        border: none !important;
        background: transparent !important;
        color: inherit !important;
        box-shadow: none !important;
    }

        /* Remove selected page button styling */
        .dataTables_wrapper .dataTables_paginate .paginate_button.current {
            background: transparent !important;
            color: inherit !important;
            font-weight: normal !important;
            border: none !important;
        }

        /* Remove hover effect */
        .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
            background: transparent !important;
            color: inherit !important;
        }


    .loading-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(255, 255, 255, 0.8);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

        .loading-overlay.active {
            display: flex !important;
        }

