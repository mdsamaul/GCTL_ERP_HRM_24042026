    /* ===== FIXED HEADER + BODY SYNC + MIN WIDTH ===== */
    /* Header কে tbody-র width অনুযায়ী ফিট করবে */
    /* Perfect Header-Body Sync for DataTables + scrollX */
    /* ==== PERFECT HEADER-BODY ALIGNMENT FOR DATATABLES + scrollX ==== */
    /* ==== পারফেক্ট অ্যালাইনমেন্ট + 200px কলাম + প্যাডিং + বর্ডার ==== */
    /* দ্বিতীয় লুকানো thead পুরোপুরি লুকিয়ে দাও – alignment কখনো ভাঙবে না */
    /* দ্বিতীয় thead পুরোপুরি বন্ধ */
    .dataTables_scrollHead {
        display: none !important;
    }

    .dataTables_scrollBody {
        overflow: visible !important;
    }

    #bookingTable {
        width: 100% !important;
    }
    #bookingTable input{
        text-align:center;
    }
    .dataTables_sizing{
        height: auto !important;
        text-align: center !important;
    }

  

    .select2-container--bootstrap-5 .select2-results {
        max-height: 250px !important;
        overflow-y: auto !important;
    }
    /* Focus state border */
    .select2-container--bootstrap-5.select2-container--focus .select2-selection--single {
        border-color: #86b7fe;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }

    /* Text container */
    .select2-container--bootstrap-5 .select2-selection--single .select2-selection__rendered {
        display: flex;
        align-items: center;
        width: 100%;
        padding-right: 30px;
        line-height: 38px;
    }

    /* Clear icon - right side */
    .select2-container--bootstrap-5 .select2-selection--single .select2-selection__clear {
        position: absolute !important;
        right: 35px !important; /* arrow থেকে left এ */
        top: 50% !important;
        transform: translateY(-50%) !important;
        margin: 0 !important;
        cursor: pointer;
        color: #999;
        font-size: 18px;
        z-index: 3;
    }

    /* Dropdown arrow - সবচেয়ে right এ */
    .select2-container--bootstrap-5 .select2-selection--single .select2-selection__arrow {
        position: absolute !important;
        top: 50% !important;
        right: 10px !important;
        height: 20px !important;
        width: 20px !important;
        margin-top: -10px !important;
        pointer-events: none;
        z-index: 2;
    }

        /* Arrow shape */
        .select2-container--bootstrap-5 .select2-selection--single .select2-selection__arrow b {
            position: absolute;
            top: 50%;
            left: 50%;
            margin-left: -4px;
            margin-top: -2px;
            border-style: solid !important;
            border-color: #333 transparent transparent transparent !important;
            border-width: 5px 4px 0 4px !important;
        }

    div.dataTables_wrapper div.dataTables_filter input {
        width: 85% !important;
    }

    div.dataTables_wrapper div.dataTables_scrollBody {
        overflow-y: auto !important;
    }

    .custom-tooltip .tooltip-inner {
        max-width: 300px; /* অথবা পছন্দমতো বড়ো করো */
        white-space: normal; /* line break allow করবে */
        background-color: #fff479;
        color: #000;
        border: 2px solid #000;
        font-size: 14px;
    }

    .select2-container--bootstrap-5 .select2-selection--single {
        /* margin-top: 5px; */
        min-height: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        padding: 0 10px;
        position: relative;
        border: 1px solid #ced4da;
        border-radius: 0.375rem;
    }

    .flatpickr-current-month .flatpickr-monthDropdown-months, .flatpickr-current-month .cur-year {
        border: none !important;
    }

</style>
<!-- Content Header (Page header) -->
<div class="container-fluid">
