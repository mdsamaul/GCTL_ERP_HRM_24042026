                                    data-title="Supplier">
                                <i class="fa fa-plus"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-1">
                    <div class="mb-1 p-0 d-flex col col-md-6">
                        <label asp-for="BookingOrderEntryBuklSetup.DeliveryMethod" class="form-label text-right p-0 pe-1 col-4"></label>                       
                        <div class="input-group input-group-sm p-0">
                            <select class="form-select form-select-sm select2" asp-for="BookingOrderEntryBuklSetup.DeliveryMethod" asp-items="ViewBag.deliveryList as SelectList">
                                <option value="">--Select Method--</option>
                            </select>

                            <button type="button"
                                    class="btn btn-outline-secondary js-quick-add"
                                    title="Quick Add Supplier"
                                    style="padding: 0.25rem 0.5rem;"
                                    data-url="@Url.Action("Index", "BuyerInfo")"
                                    data-target="#OrderDto_BuyerId"
                                    data-reload-url="@Url.Action("GetBuyerCompany", "Cascading")"
                                    data-title="Supplier">
                                <i class="fa fa-plus"></i>
                            </button>
                        </div>
                    </div>
                    <div class="mb-1 p-0 d-flex col col-md-6">
                        <label asp-for="BookingOrderEntryBuklSetup.PaymentTerms" class="form-label text-right p-0 pe-1 col-4"></label>
                        
                        <div class="input-group input-group-sm col-8 p-0">

                            <select asp-for="BookingOrderEntryBuklSetup.PaymentTerms" class="form-select form-select-sm select2" asp-items="ViewBag.pTermList as SelectList">
                                <option value="">--Select Method--</option>
                            </select>

                            <button type="button"
                                    class="btn btn-outline-secondary js-quick-add"
                                    title="Quick Add Supplier"
                                    style="padding: 0.25rem 0.5rem;"
                                    data-url="@Url.Action("Index", "BuyerInfo")"
                                    data-target="#OrderDto_BuyerId"
                                    data-reload-url="@Url.Action("GetBuyerCompany", "Cascading")"
                                    data-title="Supplier">
                                <i class="fa fa-plus"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-1">
                    <div class="mb-1 p-0 d-flex col col-md-12">
                        <label asp-for="BookingOrderEntryBuklSetup.TermsCondition" class="form-label text-right p-0 pe-1 col-2"></label>
                        @* <textarea rows="2" class="form-control form-control-sm col-10" asp-for="BookingOrderEntryBuklSetup.TermsCondition"></textarea> *@
                       

                        <div class="input-group input-group-sm p-0">

                            <select asp-for="BookingOrderEntryBuklSetup.TermsCondition" class="form-select form-select-sm select2 col-10" asp-items="ViewBag.termConditionList as SelectList">
                                <option value="">--Select Method--</option>
                            </select>

                            <button type="button"
                                    class="btn btn-outline-secondary js-quick-add"
                                    title="Quick Add Supplier"
                                    style="padding: 0.25rem 0.5rem;"
                                    data-url="@Url.Action("Index", "BuyerInfo")"
                                    data-target="#OrderDto_BuyerId"
                                    data-reload-url="@Url.Action("GetBuyerCompany", "Cascading")"
                                    data-title="Supplier">
                                <i class="fa fa-plus"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</fieldset>
